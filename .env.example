# ==========================================
# MyRecord Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# Django Security & Core Settings
# Generate a secure key in production (e.g. via `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`)
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL)
DB_NAME=myjournal
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Media Storage (Absolute directory path for photos/audio/video)
MEDIA_ROOT=C:\myjournal

# Email Configuration (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=MyJournal <your_email@gmail.com>
